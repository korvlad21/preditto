# PostgreSQL connection used by the backend inside Docker Compose.
# For a backend running on the host, export these variables with POSTGRES_HOST=localhost.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=preditto
POSTGRES_USER=preditto
POSTGRES_PASSWORD=change_me
POSTGRES_SSLMODE=disable

# Generate two independent random secrets, e.g. run `openssl rand -hex 32` twice.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
