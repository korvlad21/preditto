# Swagger UI is enabled only for this exact value; unset or other values disable it.
APP_ENV=development

# PostgreSQL connection used by the backend inside Docker Compose.
# For a backend running on the host, export these variables with POSTGRES_HOST=localhost.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=preditto
POSTGRES_USER=preditto
POSTGRES_PASSWORD=change_me
POSTGRES_SSLMODE=disable

# Generate two independent random secrets, e.g. run `openssl rand -hex 32` twice.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
JWT_REFRESH_TOKEN_SHORT_TTL=12h

# Optional SMTP sending. Enable after filling in the sender and app credentials.
# Use a Mail.ru external application password, never your main account password.
# Keep secrets in the ignored .env; quote values containing $ with single quotes.
MAIL_ENABLED=false
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Preditto
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# tls = implicit TLS (Mail.ru:465); starttls = mandatory STARTTLS (usually :587).
SMTP_TLS_MODE=tls
SMTP_AUTH_TYPE=plain
SMTP_TIMEOUT=10s
